            {
              "id": "CVE-2026-89161",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "pcre2: PCRE2: Memory corruption vulnerability in pcre2_jit_match"
              },
              "fullDescription": {
                "text": "In PCRE2 before 10.48, pcre2_jit_match mishandles a previously copied subject being passed in as a context. An incorrect free operation can occur."
