# Tool: Claude Code (Claude Opus 5.5)
# Language stack: C# / ASP.NET Core (.NET 10), PostgreSQL 18, EF Core
# Prompt Summary: "PA3 hardening: separate owner and runtime database roles, API health check, field key as a secret file, SonarQube smells, test first"
# AI Contribution: Every variable docker-compose.yml reads, with placeholders only; owner and runtime database roles; the field key as a secret file path (~100%)
# Human Modifications: None yet
# Verification: ComposeConfigTests.Env_example_lists_every_variable_with_placeholders_only
# Confidence: High
#
# Copy to .env (which is git-ignored) and replace every <...> value. Never commit .env.

# PostgreSQL superuser: used only by the database container to initialise itself.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>

# Owner of the resourcehub database and schema: only the one-shot migrate container gets it.
OWNER_DB_USER=resourcehub_owner
OWNER_DB_PASSWORD=<generate: openssl rand -hex 24>

# Runtime role the API connects as: data access only, owns nothing (must differ from OWNER_DB_USER).
APP_DB_USER=resourcehub_app
APP_DB_PASSWORD=<generate: openssl rand -hex 24>

# Host file holding the AES-256-GCM key for license key values (base64 of 32 random bytes), passed
# to the containers as a Docker secret. Create it once, outside git (secrets/ is git-ignored):
#   mkdir -p secrets && umask 077 && openssl rand -base64 32 > secrets/field_encryption_key
FIELD_ENCRYPTION_KEY_HOST_FILE=<absolute/path/to/secrets/field_encryption_key>

# Host path of the JWKS file holding the token issuer's public keys (mounted read-only).
JWKS_HOST_PATH=</absolute/path/to/jwks.json>
# Where the API reads it inside the container.
JWT_JWKS_PATH=/etc/resourcehub/jwks.json

# Tokens must come from this issuer for this audience.
JWT_ISSUER=http://localhost:9000
JWT_AUDIENCE=cs763-api

# Host port for the API (bound to 127.0.0.1 only).
API_PORT=8080
